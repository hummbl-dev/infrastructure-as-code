{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hummbl-dev/infrastructure-as-code/main/schemas/infrastructure-as-code-v0.1.json",
  "title": "Infrastructure-as-Code v0.1 Packet",
  "type": "object",
  "required": [
    "schemaVersion",
    "packetStatus",
    "infrastructureManifest",
    "authority",
    "infrastructureContract",
    "receiptRequirements"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "v0.1"
    },
    "packetStatus": {
      "type": "string",
      "enum": ["seed", "v0.1-draft", "validated-example", "v0.1-packet"]
    },
    "infrastructureManifest": {
      "type": "object",
      "required": ["id", "title", "version", "scope"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9\\-]*/[a-z0-9][a-z0-9\\-]*$"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["owner", "canActOnBehalfOf"],
      "properties": {
        "owner": {
          "type": "string"
        },
        "canActOnBehalfOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "infrastructureContract": {
      "type": "object",
      "required": [
        "environment",
        "topology",
        "dependencies",
        "changeControl",
        "rollback",
        "validation"
      ],
      "properties": {
        "environment": {
          "type": "object",
          "required": ["name", "runtimeClass", "piiPolicy", "region"],
          "properties": {
            "name": {
              "type": "string"
            },
            "runtimeClass": {
              "type": "string",
              "enum": ["agentic", "batch", "mixed", "shared"]
            },
            "piiPolicy": {
              "type": "string",
              "enum": ["none", "low", "moderate", "high", "restricted"]
            },
            "region": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "topology": {
          "type": "object",
          "required": ["components", "networkZones"],
          "properties": {
            "components": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "type", "provider", "criticality"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9\\-]*$"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["runtime", "gateway", "bus", "storage", "monitoring", "agent"]
                  },
                  "provider": {
                    "type": "string"
                  },
                  "criticality": {
                    "type": "string",
                    "enum": ["low", "medium", "high"]
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "networkZones": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "egress", "ingress"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "egress": {
                    "type": "string",
                    "enum": ["open", "restricted", "private-only"]
                  },
                  "ingress": {
                    "type": "string",
                    "enum": ["public", "private", "vpn-only"]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "required": ["requiredServices", "secretBoundary", "dependencyPolicy"],
          "properties": {
            "requiredServices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "secretBoundary": {
              "type": "string",
              "enum": ["none", "vault", "kms", "env-only", "custom-boundary"]
            },
            "dependencyPolicy": {
              "type": "string",
              "enum": ["strict", "bounded", "manual"]
            }
          },
          "additionalProperties": false
        },
        "changeControl": {
          "type": "object",
          "required": ["requiredApprovals", "reviewWindowDays", "maxOpenChanges"],
          "properties": {
            "requiredApprovals": {
              "type": "integer",
              "minimum": 1
            },
            "reviewWindowDays": {
              "type": "integer",
              "minimum": 1
            },
            "maxOpenChanges": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "rollback": {
          "type": "object",
          "required": ["enabled", "maxDowntimeMinutes", "tested"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxDowntimeMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "tested": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "validation": {
          "type": "object",
          "required": ["validationSamples", "validUntil", "negativeCasesCovered"],
          "properties": {
            "validationSamples": {
              "type": "integer",
              "minimum": 1
            },
            "validUntil": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "negativeCasesCovered": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "receiptRequirements": {
      "type": "object",
      "required": [
        "environment",
        "dependency",
        "secretBoundary",
        "review",
        "deployment",
        "rollback"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "dependency": {
          "type": "string",
          "minLength": 1
        },
        "secretBoundary": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "string",
          "minLength": 1
        },
        "deployment": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        },
        "exception": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "adjacentRepos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
